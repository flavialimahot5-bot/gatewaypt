{
  "openapi": "3.0.3",
  "info": {
    "title": "Goti Pay Portugal",
    "version": "1.0.0",
    "description": "Checkout próprio Broski. Valores em cêntimos EUR; credenciais apenas no servidor. APIs Pix da versão brasileira desativadas."
  },
  "paths": {
    "/api/pt/products/{product_id}": {
      "post": {
        "summary": "Criar pelo preço do catálogo. Mesma origem obrigatória.",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "attempt",
                  "method",
                  "customer"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempt": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "visit": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 1
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "mbway",
                      "multibanco"
                    ]
                  },
                  "customer": {
                    "type": "object",
                    "required": [
                      "name",
                      "email"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "phone": {
                        "type": "string"
                      },
                      "nif": {
                        "type": "string"
                      },
                      "address": {
                        "type": "object",
                        "required": [
                          "line1",
                          "postal_code",
                          "city"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "line1": {
                            "type": "string"
                          },
                          "line2": {
                            "type": "string"
                          },
                          "postal_code": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{3}$"
                          },
                          "city": {
                            "type": "string"
                          },
                          "region": {
                            "type": "string"
                          },
                          "country": {
                            "type": "string",
                            "enum": [
                              "PT"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/api/pt/orders/{id}": {
      "get": {
        "summary": "Consultar estado local por ID opaco, sem dados pessoais",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/api/pt/webhook": {
      "post": {
        "summary": "Webhook com HMAC-SHA256 do corpo bruto",
        "parameters": [
          {
            "name": "Broski-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/api/pt/admin": {
      "get": {
        "summary": "Configuração e pedidos; login administrativo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      },
      "post": {
        "summary": "Guardar credenciais cifradas; login e mesma origem",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "secret": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/api/pt/provider-orders": {
      "get": {
        "summary": "Listar Broski; login administrativo",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "method",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/api/pt/provider-orders/{id}": {
      "get": {
        "summary": "Consulta pontual Broski; login administrativo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/api/pt/refunds/{id}": {
      "post": {
        "summary": "Reembolso; login e mesma origem. {} total; amount em cêntimos para parcial.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta JSON; contratos completos em README.md"
          },
          "401": {
            "description": "Não autorizado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    }
  }
}
