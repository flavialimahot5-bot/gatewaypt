{
  "name": "goti-pay-portugal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5174",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:security": "node --test --test-name-pattern=\"anonymous and unlisted|cross-origin administrative|provider credentials use|callback allowlist|rate limits are|body size limits\" tests/security.mjs && node tests/portugal.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:portugal": "node tests/portugal.mjs"
  },
